# Copy this file to .env and fill in your values

# Database (SQLite by default - no setup needed!)
DATABASE_URL=sqlite:///./chefai.db

# JWT Secret Key (change this to a long random string!)
SECRET_KEY=your-super-secret-jwt-key-change-this-in-production-please
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Google Gemini API Key (get free key at https://ai.google.dev)
# Leave empty to use mock AI responses (still fully functional!)
GEMINI_API_KEY=

# App settings
APP_NAME=ChefAI
DEBUG=True
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
